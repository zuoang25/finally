{
  "name": "finally-e2e",
  "private": true,
  "version": "0.1.0",
  "description": "Playwright end-to-end suite for FinAlly, run against the production container.",
  "scripts": {
    "app:up": "docker compose -f docker-compose.test.yml up -d --build --force-recreate --wait finally-test",
    "app:down": "docker compose -f docker-compose.test.yml down -v --remove-orphans",
    "app:logs": "docker compose -f docker-compose.test.yml logs finally-test",
    "test": "playwright test",
    "typecheck": "tsc --noEmit",
    "test:headed": "playwright test --headed",
    "test:report": "playwright show-report",
    "e2e": "npm run app:up && npm run test",
    "e2e:docker": "docker compose -f docker-compose.test.yml run --rm playwright"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/node": "^22.10.2",
    "typescript": "^5.9.3"
  }
}
