# FinAlly environment configuration
#
# There is no .env file checked into the repo. Create one before running the app:
#   cp .env.example .env      (macOS/Linux)
#   Copy-Item .env.example .env   (Windows PowerShell)
# Then fill in the values you need below.

# Required for real LLM chat responses. Get a key at https://openrouter.ai/keys.
# Unused (and can be left blank) when LLM_MOCK=true.
OPENROUTER_API_KEY=

# Optional. A Massive (Polygon.io) API key for real market data.
# Leave empty to use the built-in GBM price simulator (recommended for most users;
# no external dependency, no rate limits, works out of the box).
MASSIVE_API_KEY=

# Optional. Set to "true" to get deterministic mock LLM chat responses instead of
# calling OpenRouter — useful for development without an API key and for fast,
# reproducible E2E tests. Truthy values: "true", "1", "yes" (case-insensitive).
LLM_MOCK=false

# Optional. Overrides where the SQLite database file is written.
# The Docker image sets this to /app/db/finally.db automatically; leave unset
# unless you're running the backend outside Docker and want a custom path.
FINALLY_DB_PATH=

# Optional. Port uvicorn listens on inside the container. Defaults to 8000.
PORT=8000
